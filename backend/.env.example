# ===== 应用基础配置 =====
APP_NAME=Lost-and-Found Intelligent Platform
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

# ===== 数据库连接 =====
# 本机无 MySQL 时使用 SQLite（默认值），开箱即用：
DATABASE_URL=sqlite:///./lost_found.db
# 使用 Docker 启动 MySQL 后改为（见 docker/docker-compose.yml）：
# DATABASE_URL=mysql+pymysql://laf_user:laf_pass@127.0.0.1:3306/lost_found?charset=utf8mb4

# ===== 跨域来源（逗号分隔） =====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
