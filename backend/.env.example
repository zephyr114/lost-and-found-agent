# ===== 应用基础配置 =====
APP_NAME=Lost-and-Found Intelligent Platform
APP_VERSION=0.2.0
APP_ENV=development
DEBUG=true

# ===== 数据库连接 =====
# 本机无 MySQL 时使用 SQLite（默认值），开箱即用：
DATABASE_URL=sqlite:///./lost_found.db
# 使用 Docker 启动 MySQL 后改为（见 docker/docker-compose.yml）：
# DATABASE_URL=mysql+pymysql://laf_user:laf_pass@127.0.0.1:3306/lost_found?charset=utf8mb4

# ===== JWT 认证 =====
# 生产环境务必改为强随机密钥（例如 openssl rand -hex 32），绝不可提交真实密钥
JWT_SECRET_KEY=dev-only-secret-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== 接口限流（按 IP 每分钟；测试环境可设 RATE_LIMIT_ENABLED=false）=====
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_GLOBAL_PER_MINUTE=300

# ===== 初始管理员（首次启动自动创建，生产环境务必修改）=====
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123456

# ===== 跨域来源（逗号分隔） =====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== 大语言模型（可选；不配置则 Agent 使用内置规则引擎）=====
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
